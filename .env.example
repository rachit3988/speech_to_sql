# Copy to .env and fill in. Every S2S_* setting is documented in src/speech_to_sql/config.py.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Voice input. Leave empty in dev to run text-only; required when S2S_ENVIRONMENT=prod
# unless S2S_STT_PROVIDER=none.
DEEPGRAM_API_KEY=

# --- Database ---------------------------------------------------------------
# Local demo (created by `make seed`):
S2S_DATABASE_URL=sqlite:///./data/demo.db
# Postgres (connect as the read-only role from deploy/postgres/readonly_role.sql):
# S2S_DATABASE_URL=postgresql://s2s_readonly:change-me@localhost:5432/speech_demo
# S2S_DB_SCHEMAS=public
# S2S_HIDDEN_TABLES=audit_log
# S2S_HIDDEN_COLUMNS=customers.email,users.password_hash
# S2S_STATEMENT_TIMEOUT_S=10
# S2S_MAX_RESULT_ROWS=500

# --- Model ------------------------------------------------------------------
# S2S_LLM_MODEL=claude-opus-5-5
# low = fastest/cheapest, medium = default balance, high = hardest schemas
# S2S_LLM_EFFORT=medium
# S2S_AGENT_MAX_ITERATIONS=12
# S2S_AGENT_TIMEOUT_S=180

# --- Speech -----------------------------------------------------------------
# Domain words the recogniser should favour (product names, jargon), comma-separated.
# S2S_STT_KEYTERMS=EchoBuds,Globex,ClearView
# S2S_STT_PROVIDER=deepgram

# --- Use by other agents (MCP at /mcp, or `speech-to-sql mcp` over stdio) ---------
# Tell calling agents what this data is so they know when to use it:
# S2S_MCP_DATA_DESCRIPTION=Acme e-commerce data: customers, orders, products, revenue (2024-2026)
# S2S_MCP_ENABLED=true
# S2S_MCP_MAX_ROWS=100
# S2S_MCP_ALLOW_RAW_SQL=true
# Public host names for /mcp when running without API keys (localhost is always allowed):
# S2S_MCP_ALLOWED_HOSTS=sql-agent.internal

# --- Service ----------------------------------------------------------------
# S2S_ENVIRONMENT=dev
# Comma-separated API keys for the X-API-Key header. Empty = no auth (dev only).
# S2S_API_KEYS=
# S2S_RATE_LIMIT_PER_MINUTE=30
# S2S_TIMEZONE=UTC
# S2S_LOG_PAYLOADS=false
